# Trading 212 API Credentials
# Trading 212 uses HTTP Basic Auth (API_KEY:API_SECRET).
TRADING212_API_KEY=your_trading212_api_key_here
TRADING212_API_SECRET=your_trading212_api_secret_here
USE_LIVE=false

# System 2 Deliberative Engine (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Market Data Providers
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Dashboard Control Plane & Emergency Panic Auth Tokens (min 16 characters when set).
# Resolution precedence: DASHBOARD_AUTH_TOKEN -> PANIC_FLATTEN_TOKEN -> data/.dashboard_token.
# Leave blank to auto-bootstrap a persistent 0600 token file at data/.dashboard_token.
DASHBOARD_AUTH_TOKEN=
PANIC_FLATTEN_TOKEN=
