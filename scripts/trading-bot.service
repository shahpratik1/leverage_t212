[Unit]
Description=Trading 212 Quantitative Leveraged Engine (Raspi Runner)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shahpratik11
WorkingDirectory=/home/shahpratik11/modest-bose
EnvironmentFile=/home/shahpratik11/modest-bose/.env
ExecStart=/home/shahpratik11/modest-bose/venv/bin/python3 -m trading_system.orchestrator --interval 5 --monitor-interval 10 --dashboard-port 8080
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30

# Logging
StandardOutput=append:/home/shahpratik11/modest-bose/trading_bot.log
StandardError=append:/home/shahpratik11/modest-bose/trading_bot.err

[Install]
WantedBy=multi-user.target
